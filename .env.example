# ─── Sawla Tours — Environment Variables ──────────────────────────────────────
# Copy this file to `.env.local` for local development, and set the same values
# in your production hosting environment (Vercel / Netlify / etc.).
# Never commit real keys — `.env*` files are gitignored.

# ── Enquiry email (Resend) ──
# Get an API key at https://resend.com/api-keys
# Until this is set, the enquiry form validates and logs submissions but does
# NOT send email (so development is not blocked).
RESEND_API_KEY=

# Inbox that receives enquiries (optional — defaults to explore@sawlatours.com)
ENQUIRY_TO=explore@sawlatours.com

# Verified sender on your Resend domain (optional — defaults shown).
# The domain (sawlatours.com) must be verified in your Resend account first.
ENQUIRY_FROM=Sawla Tours <enquiries@sawlatours.com>

# ── Google Analytics 4 ──
# Create a GA4 property at https://analytics.google.com → Admin → Data Streams,
# then copy the Measurement ID (looks like G-XXXXXXXXXX).
# When this is set, GA4 loads automatically (via @next/third-parties, optimised
# and only on the client). When empty, no analytics script is loaded at all.
NEXT_PUBLIC_GA_ID=
